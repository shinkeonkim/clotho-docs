    {
      "id": "c1",
      "time": 0,
      "label": "where it has been",
      "subtitle": "a still frame still says where the cursor came from"
    },
    {
      "id": "c2",
      "time": 1800,
      "label": "a line, or dots",
      "subtitle": "blended interpolation joins the samples; stepped never was in between"
    },
    {
      "id": "c3",
      "time": 4400,
      "label": "it stops when the cursor stops",
      "subtitle": "samples piled on one spot do not darken it, and the tail ages out with the window"
    },
    {
      "id": "c4",
      "time": 6400,
      "label": "coming back leaves no smear",
      "subtitle": "the trail is re-derived from the document every frame, never accumulated"
    }
  ],
